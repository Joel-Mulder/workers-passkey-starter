<mxfile host="app.diagrams.net" type="device">
  <diagram id="setup" name="Full setup">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Passkeys + Apple/Google sign-in on one Cloudflare Worker&lt;/b&gt;" style="text;html=1;fontSize=18;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="worker" value="&lt;b&gt;Cloudflare Worker&lt;/b&gt;&lt;br&gt;Hono · TypeScript" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#EEEDFE;strokeColor=#534AB7;verticalAlign=top;fontSize=14;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="390" y="60" width="340" height="440" as="geometry" />
        </mxCell>
        <mxCell id="user" value="User" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="245" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="browser" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;own passkey.js · no SDK&lt;br&gt;&lt;i&gt;native WebAuthn API&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="180" y="230" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="swa" value="&lt;b&gt;@simplewebauthn/server&lt;/b&gt;&lt;br&gt;make challenge · verify passkey signature&lt;br&gt;&lt;i&gt;uses native Web Crypto&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="410" y="110" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="arctic" value="&lt;b&gt;arctic&lt;/b&gt;&lt;br&gt;OAuth redirect · state · PKCE · code exchange" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="410" y="210" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="jose" value="&lt;b&gt;jose&lt;/b&gt;&lt;br&gt;verify Apple/Google ID token (issuer, audience, nonce)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="410" y="300" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sess" value="&lt;b&gt;Sessions + guards&lt;/b&gt;&lt;br&gt;HttpOnly cookie · origin check · rate limits · audit log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="410" y="410" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="idp" value="&lt;b&gt;Apple / Google&lt;/b&gt;&lt;br&gt;OIDC sign-in + public keys (JWKS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="800" y="200" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="&lt;b&gt;D1 (SQLite)&lt;/b&gt;&lt;br&gt;challenges (10 min, single use)&lt;br&gt;passkeys (public keys)&lt;br&gt;linked Apple/Google IDs&lt;br&gt;sessions · rate counters" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#FAECE7;strokeColor=#993C1D;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="800" y="330" width="200" height="140" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="user" target="browser"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="passkey" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=12;" edge="1" parent="1" source="browser" target="swa"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="Apple / Google" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=12;" edge="1" parent="1" source="browser" target="arctic"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="redirect + callback" style="endArrow=block;startArrow=block;html=1;rounded=0;fontSize=12;" edge="1" parent="1" source="arctic" target="idp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="arctic" target="jose"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="public keys" style="endArrow=block;dashed=1;html=1;rounded=0;fontSize=12;" edge="1" parent="1" source="jose" target="idp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="endArrow=block;startArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="swa" target="d1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="760" y="145" /><mxPoint x="760" y="370" /></Array></mxGeometry></mxCell>
        <mxCell id="e8" style="endArrow=block;startArrow=block;html=1;rounded=0;" edge="1" parent="1" source="sess" target="d1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="jose" target="sess"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="session cookie (HttpOnly)" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=12;" edge="1" parent="1" source="sess" target="browser"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="265" y="440" /></Array></mxGeometry></mxCell>
        <mxCell id="legend" value="Grey = outside the Worker · teal = inside the Worker · orange = database" style="text;html=1;fontSize=12;fontColor=#5F5E5A;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="600" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="passkey-login" name="Passkey sign-in">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="&lt;b&gt;Signing in with a passkey&lt;/b&gt;" style="text;html=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="500" height="30" as="geometry" /></mxCell>
        <mxCell id="s1" value="&lt;b&gt;1 · Get challenge&lt;/b&gt;&lt;br&gt;Worker makes a random challenge, stores it in D1 (10 min, single use)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="220" height="90" as="geometry" /></mxCell>
        <mxCell id="s2" value="&lt;b&gt;2 · Device signs&lt;/b&gt;&lt;br&gt;Face ID / Touch ID unlocks the private key, which never leaves the device" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="300" y="70" width="220" height="90" as="geometry" /></mxCell>
        <mxCell id="s3" value="&lt;b&gt;3 · Verify&lt;/b&gt;&lt;br&gt;Worker takes the challenge, checks the signature with the public key, origin and RP ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontSize=13;" vertex="1" parent="1"><mxGeometry x="560" y="70" width="220" height="90" as="geometry" /></mxCell>
        <mxCell id="s4" value="&lt;b&gt;4 · Session&lt;/b&gt;&lt;br&gt;Session row in D1, HttpOnly cookie in the browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontSize=13;" vertex="1" parent="1"><mxGeometry x="820" y="70" width="220" height="90" as="geometry" /></mxCell>
        <mxCell id="f1" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f2" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="o1" value="&lt;b&gt;Apple / Google instead&lt;/b&gt;: start (state + nonce + PKCE for Google) → Apple/Google sign-in → callback → exchange code (arctic) → verify ID token (jose) → match provider + subject, never email → session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;dashed=1;fontSize=13;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="1000" height="60" as="geometry" /></mxCell>
        <mxCell id="n" value="Why it fits Worker limits: crypto runs in native Web Crypto (low CPU), only small edge-ready libraries (small bundle), challenges live in D1 (Workers keep no memory between requests)." style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#5F5E5A;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="1000" height="40" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
