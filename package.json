{
  "name": "workers-passkey-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Passkeys + Sign in with Apple/Google for a Hono app on Cloudflare Workers, with D1 as the only store.",
  "scripts": {
    "dev": "wrangler dev --local --ip localhost --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "size": "wrangler deploy --dry-run --outdir dist",
    "size:modules": "wrangler deploy src/example-modules.ts --dry-run --outdir dist-modules"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.0.3",
    "arctic": "3.7.0",
    "hono": "4.13.13",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261009.1",
    "@types/node": "26.6.4",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
